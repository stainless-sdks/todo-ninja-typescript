{
  "dxt_version": "0.2",
  "name": "todo-ninja-mcp",
  "version": "0.1.0-alpha.1",
  "description": "The official MCP Server for the Todo Ninja API",
  "author": {
    "name": "Todo Ninja",
    "email": "info@stainless.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexarena/todo-ninja-typescript.git"
  },
  "homepage": "https://github.com/alexarena/todo-ninja-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "https://docs.todoninja.app",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "TODO_NINJA_API_KEY": "${user_config.TODO_NINJA_API_KEY}"
      }
    }
  },
  "user_config": {
    "TODO_NINJA_API_KEY": {
      "title": "bearer_token",
      "description": "",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
